# ==============================================================================
# Daddy Soda House Backend - Environment Configuration Template
# Copy this file to .env and configure real values for your environment.
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=daddy_soda_house
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Server Configuration
PORT=8080

# Security & JWT Configuration
# Minimum 256 bits (32 bytes) hex or ASCII string for HMAC-SHA256
JWT_SECRET=dev_only_jwt_secret_key_minimum_256_bits_for_testing_purposes_only
JWT_EXPIRATION_MS=86400000

# IoT Telemetry Security
APP_IOT_API_KEY=dev_iot_api_key_placeholder
IOT_OFFLINE_THRESHOLD_MINUTES=30

# Initial SUPER_ADMIN Bootstrap Configuration
# On application startup, if no SUPER_ADMIN exists in the database, this account is created.
INITIAL_ADMIN_NAME=Super Administrator
INITIAL_ADMIN_MOBILE=9999999999
INITIAL_ADMIN_EMAIL=admin@Daddysoda.com
INITIAL_ADMIN_PASSWORD=Admin@12345

# Company & Invoice Billing Configuration
COMPANY_NAME=Daddy Soda House Pvt Ltd
COMPANY_ADDRESS=Shop 12, Phoenix Marketcity, Viman Nagar, Pune, Maharashtra 411014
COMPANY_MOBILE=9999999999
COMPANY_EMAIL=accounts@Daddysoda.com
COMPANY_GSTIN=27AABCS1429B1Z1
DEFAULT_GST_RATE_PERCENT=18.00
INVOICE_STORAGE_PATH=./storage/invoices

# Public Enquiry & WhatsApp Redirection Configuration
WHATSAPP_ENQUIRY_NUMBER=919876543210

# CORS Allowed Origins (comma-separated list for production, e.g. https://Daddysoda.com,https://admin.Daddysoda.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Spring Profiles Active (prod for production, dev for local development)
SPRING_PROFILES_ACTIVE=prod


